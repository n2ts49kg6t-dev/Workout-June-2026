<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Workout">
<title>Workout Routine</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#F0F2F5;color:#111827;min-height:100vh}
button{font-family:inherit;cursor:pointer;border:none;background:none}
input{font-family:inherit}

/* ── Header ── */
.hdr{background:#fff;border-bottom:1px solid #E5E7EB;padding:18px 16px 0;position:sticky;top:0;z-index:200;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.hdr h1{font-size:20px;font-weight:800;color:#111827;letter-spacing:-.3px;margin-bottom:14px}
.tabs{display:flex;gap:0}
.tab{flex:1;padding:9px 4px;font-size:11px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:#9CA3AF;border-bottom:2px solid transparent;transition:all .15s;background:none;border-top:none;border-left:none;border-right:none}
.tab.on{color:#4F46E5;border-bottom-color:#4F46E5}

/* ── Content ── */
.content{padding:16px 14px 90px;max-width:680px;margin:0 auto}

/* ── Day selector ── */
.day-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:16px}
.day-btn{padding:10px 6px 9px;border-radius:10px;border:1.5px solid #E5E7EB;background:#fff;text-align:left;transition:all .15s}
.day-btn.on{border-color:var(--c);background:color-mix(in srgb,var(--c) 9%,#fff)}
.day-lbl{font-size:9px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:#C4C9D4;margin-bottom:3px}
.day-btn.on .day-lbl{color:var(--c)}
.day-title{font-size:11px;font-weight:700;color:#9CA3AF;line-height:1.3}
.day-btn.on .day-title{color:#111827}

/* ── Tags ── */
.tag{display:inline-block;border-radius:4px;padding:1px 6px;font-size:9px;font-weight:800;letter-spacing:.6px}
.t-NEW{background:#ECFDF5;border:1px solid #6EE7B7;color:#059669}
.t-TRAP{background:#EEF2FF;border:1px solid #A5B4FC;color:#4F46E5}
.legend{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;align-items:center}
.legend span{font-size:11px;color:#6B7280;display:flex;align-items:center;gap:5px}

/* ── Exercise card ── */
.ex-list{display:flex;flex-direction:column;gap:10px}
.card{background:#fff;border:1.5px solid #E5E7EB;border-radius:14px;overflow:hidden}
.card.new-card{border-color:#86EFAC}
.card-hdr{padding:14px 14px 12px}
.card-tags{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:8px}
.name-row{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;cursor:pointer;margin-bottom:5px}
.ex-name{font-size:15px;font-weight:800;color:#111827;flex:1;line-height:1.3}
.form-btn{flex-shrink:0;border:1px solid #E5E7EB;border-radius:6px;padding:3px 8px;font-size:9px;font-weight:800;letter-spacing:.6px;color:#9CA3AF;background:#F9FAFB;white-space:nowrap;transition:all .15s}
.form-btn.open{color:var(--c);border-color:var(--c);background:color-mix(in srgb,var(--c) 8%,#fff)}
.ex-note{font-size:12px;color:#6B7280;line-height:1.55;margin-bottom:10px}

/* ── Weight ── */
.w-row{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.w-lbl{font-size:10px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:#C4C9D4}
.w-btn{background:#F3F4F6;border:1px solid #E5E7EB!important;border-radius:7px;color:#4338CA;font-size:13px;font-weight:700;padding:4px 11px;display:flex;align-items:center;gap:5px;transition:background .1s}
.w-btn:active{background:#E8EAFF}
.w-input{background:#fff;border:1.5px solid #6366F1!important;border-radius:7px;color:#111827;font-size:14px;font-weight:700;padding:4px 8px;width:90px;outline:none}
.bw-tag{font-size:12px;color:#9CA3AF;font-weight:600}

/* ── Progress bar ── */
.prog-row{display:flex;align-items:center;gap:8px}
.prog-track{flex:1;height:3px;background:#F0F2F5;border-radius:2px;overflow:hidden}
.prog-fill{height:100%;border-radius:2px;transition:width .3s}
.prog-lbl{font-size:10px;color:#C4C9D4;min-width:38px;text-align:right}

/* ── Form guide ── */
.form-panel{display:none;border-top:1px solid #F0F2F5;padding:14px;background:#FAFBFC}
.form-panel.open{display:block}
.fg-section{margin-bottom:12px}
.fg-section:last-child{margin-bottom:0}
.fg-lbl{font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:5px}
.fg-lbl.setup,.fg-lbl.exec{color:var(--c)}
.fg-lbl.cues{color:#059669}
.fg-lbl.avoid{color:#DC2626}
.fg-text{font-size:12px;color:#374151;line-height:1.7}
.cue-list{display:flex;flex-direction:column;gap:5px}
.cue{display:flex;gap:7px;align-items:flex-start}
.cue-arrow{color:#059669;font-size:11px;flex-shrink:0;margin-top:2px;font-weight:700}

/* ── Sets ── */
.sets{border-top:1px solid #F0F2F5}
.set-row{display:flex;align-items:center;gap:12px;padding:11px 14px;cursor:pointer;border-bottom:1px solid #F0F2F5;transition:background .1s}
.set-row:last-child{border-bottom:none}
.chk{width:20px;height:20px;border-radius:5px;border:1.5px solid #D1D5DB;background:#fff;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .15s}
.chk.done{border-color:var(--c);background:var(--c)}
.set-reps{font-size:13px;font-weight:600;color:#1F2937;flex:1}
.set-reps.done{color:#C4C9D4;text-decoration:line-through}
.set-rest{font-size:11px;color:#C4C9D4;flex-shrink:0}

/* ── Info cards (fat loss / traps tabs) ── */
.info-stack{display:flex;flex-direction:column;gap:10px}
.ic{background:#fff;border:1.5px solid #E5E7EB;border-radius:14px;padding:16px}
.ic.amber-card{background:#FFFBEB;border-color:#FDE68A}
.ic.indigo-card{border-color:#A5B4FC}
.ic-title{font-size:13px;font-weight:800;margin-bottom:6px}
.ic-title.amber{color:#D97706}
.ic-title.indigo{color:#4338CA}
.ic-body{font-size:13px;color:#374151;line-height:1.65}
.ic-body strong{color:#111827}
.tip-row{display:flex;gap:12px;align-items:flex-start}
.tip-icon{font-size:20px;margin-top:1px}
.tip-name{font-size:14px;font-weight:700;color:#111827;margin-bottom:3px}
.tip-body{font-size:13px;color:#6B7280;line-height:1.6}
.badge-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.day-badge{background:#EEF2FF;border:1px solid #A5B4FC;border-radius:4px;padding:2px 8px;font-size:10px;color:#4338CA;font-weight:700}
</style>
</head>
<body>

<div class="hdr">
  <h1>Your Workout Routine</h1>
  <div class="tabs">
    <button class="tab on" onclick="switchTab('routine',this)">📋 Routine</button>
    <button class="tab" onclick="switchTab('fatloss',this)">🔥 Fat Loss</button>

  </div>
</div>

<div class="content">

  <!-- ROUTINE TAB -->
  <div id="t-routine">
    <div class="day-grid" id="day-grid"></div>

    <div class="ex-list" id="ex-list"></div>
  </div>

  <!-- FAT LOSS TAB -->
  <div id="t-fatloss" style="display:none">
    <div class="info-stack">
      <div class="ic"><div class="tip-row"><span class="tip-icon">📉</span><div><div class="tip-name">Small calorie deficit</div><div class="tip-body">~250–350 kcal/day below maintenance. Aggressive cuts kill muscle at your training level. Track with MyFitnessPal for 2–3 weeks.</div></div></div></div>
      <div class="ic"><div class="tip-row"><span class="tip-icon">🥩</span><div><div class="tip-name">Protein: 136–187g/day</div><div class="tip-body">1.6–2.2g per kg bodyweight. Preserves muscle in a deficit and keeps you full.</div></div></div></div>
      <div class="ic"><div class="tip-row"><span class="tip-icon">🏃</span><div><div class="tip-name">2× Zone 2 cardio on rest days</div><div class="tip-body">20–30 min brisk walk or incline treadmill. Burns fat without impairing muscle recovery.</div></div></div></div>
      <div class="ic"><div class="tip-row"><span class="tip-icon">😴</span><div><div class="tip-name">Sleep is a training variable</div><div class="tip-body">Poor sleep raises cortisol which directly increases visceral fat storage. 7–9 hours non-negotiable.</div></div></div></div>
    </div>
  </div>



</div>

