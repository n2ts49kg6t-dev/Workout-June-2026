// ─────────────────────────────────────────────
//  STATE  (weights + seats persisted in localStorage)
// ─────────────────────────────────────────────
const LS_WEIGHTS = 'workout_weights_v2';
const LS_SEATS   = 'workout_seats_v2';

function loadWeights() {
  try {
    const saved = JSON.parse(localStorage.getItem(LS_WEIGHTS));
    if (saved && saved.length === DAYS.length) return saved;
  } catch(e){}
  return DAYS.map(d => d.exercises.map(e => e.weight));
}

function loadSeats() {
  try {
    const saved = JSON.parse(localStorage.getItem(LS_SEATS));
    if (saved && saved.length === DAYS.length) return saved;
  } catch(e){}
  return DAYS.map(d => d.exercises.map(e => e.seat !== undefined ? e.seat : null));
}

function saveWeights() {
  try { localStorage.setItem(LS_WEIGHTS, JSON.stringify(weights)); } catch(e){}
}

function saveSeats() {
  try { localStorage.setItem(LS_SEATS, JSON.stringify(seats)); } catch(e){}
}

let weights = loadWeights();
let seats   = loadSeats();
let activeDay = 0;
let checked = {};
let formOpen = {};

// ─────────────────────────────────────────────
//  HELPERS
// ─────────────────────────────────────────────
const CHECK_SVG = '<svg width="10" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4L3.5 6.5L9 1" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';

function hexAlpha(hex, a) {
  const r=parseInt(hex.slice(1,3),16), g=parseInt(hex.slice(3,5),16), b=parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${a})`;
}

// ─────────────────────────────────────────────
//  TAB SWITCHING
// ─────────────────────────────────────────────
function switchTab(id, btn) {
  ['routine','fatloss'].forEach(t => {
    document.getElementById('t-'+t).style.display = t===id ? '' : 'none';
  });
  document.querySelectorAll('.tab').forEach(b => b.classList.toggle('on', b===btn));
}

// ─────────────────────────────────────────────
//  DAY GRID
// ─────────────────────────────────────────────
function renderDayGrid() {
  document.getElementById('day-grid').innerHTML = DAYS.map((d,i) => `
    <button class="day-btn${activeDay===i?' on':''}" style="--c:${d.color}" onclick="selectDay(${i})">
      <div class="day-lbl">${d.label}</div>
      <div class="day-title">${d.title}</div>
    </button>`).join('');
}

function selectDay(i) {
  activeDay = i;
  renderDayGrid();
  renderExercises();
}

// ─────────────────────────────────────────────
//  SEAT CELL
// ─────────────────────────────────────────────
function renderSeatCell(di, ei) {
  const el = document.getElementById(`sc-${di}-${ei}`);
  if (!el) return;
  const s = seats[di][ei];
  el.innerHTML = `<button class="w-btn" onclick="startSeatEdit(${di},${ei})">✏️ ${s||'—'}</button>`;
}

function startSeatEdit(di, ei) {
  const el = document.getElementById(`sc-${di}-${ei}`);
  const s  = seats[di][ei] || '';
  el.innerHTML = `<input class="w-input" id="si-${di}-${ei}" type="text" inputmode="decimal" value="${s}" placeholder="0">`;
  const inp = document.getElementById(`si-${di}-${ei}`);
  inp.focus(); inp.select();
  const commit = () => {
    const val = inp.value.trim();
    seats[di][ei] = val;
    saveSeats();
    renderSeatCell(di, ei);
  };
  inp.addEventListener('blur', commit);
  inp.addEventListener('keydown', e => { if(e.key==='Enter') { inp.blur(); } });
}

// ─────────────────────────────────────────────
//  WEIGHT CELL
// ─────────────────────────────────────────────
function renderWeightCell(di, ei) {
  const el = document.getElementById(`wc-${di}-${ei}`);
  if (!el) return;
  const ex = DAYS[di].exercises[ei];
  const w = weights[di][ei];
  if (w === 'BW') { el.innerHTML = '<span class="bw-tag">Bodyweight</span>'; return; }
  el.innerHTML = `<button class="w-btn" onclick="startEdit(${di},${ei})">✏️ ${w}${ex.unit?' '+ex.unit:''}</button>`;
}

function startEdit(di, ei) {
  const el = document.getElementById(`wc-${di}-${ei}`);
  const ex = DAYS[di].exercises[ei];
  const w = weights[di][ei];
  el.innerHTML = `<input class="w-input" id="wi-${di}-${ei}" type="text" inputmode="decimal" value="${w}">${ex.unit?`<span style="font-size:12px;color:#9CA3AF;margin-left:5px">${ex.unit}</span>`:''}`;
  const inp = document.getElementById(`wi-${di}-${ei}`);
  inp.focus(); inp.select();
  const commit = () => {
    const val = inp.value.trim();
    if (val) { weights[di][ei] = val; saveWeights(); }
    renderWeightCell(di, ei);
  };
  inp.addEventListener('blur', commit);
  inp.addEventListener('keydown', e => { if(e.key==='Enter') { inp.blur(); } });
}

// ─────────────────────────────────────────────
//  FORM GUIDE TOGGLE
// ─────────────────────────────────────────────
function toggleForm(dayId, ei) {
  const key = `${dayId}-${ei}`;
  formOpen[key] = !formOpen[key];
  const panel = document.getElementById(`fp-${dayId}-${ei}`);
  const btn   = document.getElementById(`fb-${dayId}-${ei}`);
  if (panel) panel.classList.toggle('open', !!formOpen[key]);
  if (btn)   { btn.textContent = formOpen[key] ? '▲ FORM' : '▼ FORM'; btn.classList.toggle('open', !!formOpen[key]); }
}

// ─────────────────────────────────────────────
//  SET CHECK
// ─────────────────────────────────────────────
function toggleCheck(dayId, ei, si) {
  const key = `${dayId}-${ei}-${si}`;
  checked[key] = !checked[key];
  const ticked = checked[key];
  const color  = DAYS.find(d=>d.id===dayId).color;
  const row    = document.getElementById(`sr-${dayId}-${ei}-${si}`);
  const box    = document.getElementById(`cb-${dayId}-${ei}-${si}`);
  const lbl    = document.getElementById(`rl-${dayId}-${ei}-${si}`);
  if (row) row.style.background = ticked ? hexAlpha(color,.05) : '';
  if (box) { box.classList.toggle('done',ticked); box.style.cssText=`border-color:${ticked?color:'#D1D5DB'};background:${ticked?color:'#fff'}`; box.innerHTML=ticked?CHECK_SVG:''; }
  if (lbl) lbl.classList.toggle('done', ticked);
  updateProgress(dayId, ei);
}

function updateProgress(dayId, ei) {
  const ex   = DAYS.find(d=>d.id===dayId).exercises[ei];
  const done = ex.sets.filter((_,i) => checked[`${dayId}-${ei}-${i}`]).length;
  const pct  = Math.round(done/ex.sets.length*100);
  const fill = document.getElementById(`pf-${dayId}-${ei}`);
  const lbl  = document.getElementById(`pl-${dayId}-${ei}`);
  if (fill) fill.style.width = pct+'%';
  if (lbl)  lbl.textContent  = `${done}/${ex.sets.length}`;
}

// ─────────────────────────────────────────────
//  RENDER EXERCISES
// ─────────────────────────────────────────────
function renderExercises() {
  const day = DAYS[activeDay];
  const di  = activeDay;
  const c   = day.color;

  document.getElementById('ex-list').innerHTML = day.exercises.map((ex, ei) => {
    const w       = weights[di][ei];
    const hasSeat = ex.seat !== undefined;
    const fOpen   = !!formOpen[`${day.id}-${ei}`];
    const done    = ex.sets.filter((_,si) => checked[`${day.id}-${ei}-${si}`]).length;
    const pct     = Math.round(done/ex.sets.length*100);

    const weightHTML = w==='BW' ? '<span class="bw-tag">Bodyweight</span>'
      : `<button class="w-btn" onclick="startEdit(${di},${ei})">✏️ ${w}${ex.unit?' '+ex.unit:''}</button>`;

    const seatHTML = hasSeat ? `
      <span class="w-lbl">Seat</span>
      <div id="sc-${di}-${ei}"><button class="w-btn" onclick="startSeatEdit(${di},${ei})">✏️ ${seats[di][ei]||'—'}</button></div>` : '';

    const setsHTML = ex.sets.map((s,si) => {
      const ticked = !!checked[`${day.id}-${ei}-${si}`];
      return `<div class="set-row${ticked?' done':''}" id="sr-${day.id}-${ei}-${si}"
        style="${ticked?`background:${hexAlpha(c,.05)}`:''}"
        onclick="toggleCheck(${day.id},${ei},${si})">
        <div class="chk${ticked?' done':''}" id="cb-${day.id}-${ei}-${si}"
          style="border-color:${ticked?c:'#D1D5DB'};background:${ticked?c:'#fff'}">${ticked?CHECK_SVG:''}</div>
        <span class="set-reps${ticked?' done':''}" id="rl-${day.id}-${ei}-${si}">Set ${si+1} — ${s.r}</span>
        <span class="set-rest">${s.rest}</span>
      </div>`;
    }).join('');

    const formHTML = `
      <div class="fg-section"><div class="fg-lbl setup">Setup</div><div class="fg-text">${ex.form.setup}</div></div>
      <div class="fg-section"><div class="fg-lbl exec">Execution</div><div class="fg-text">${ex.form.exec}</div></div>
      <div class="fg-section"><div class="fg-lbl cues">Key Cues</div><div class="cue-list">${ex.form.cues.map(c=>`<div class="cue"><span class="cue-arrow">→</span><span class="fg-text">${c}</span></div>`).join('')}</div></div>
      <div class="fg-section"><div class="fg-lbl avoid">Avoid</div><div class="fg-text">${ex.form.avoid}</div></div>`;

    return `
    <div class="card" style="--c:${c}">
      <div class="card-hdr">
        <div class="name-row" onclick="toggleForm(${day.id},${ei})">
          <div class="ex-name">${ex.name}</div>
          <button class="form-btn${fOpen?' open':''}" id="fb-${day.id}-${ei}" style="--c:${c}">${fOpen?'▲ FORM':'▼ FORM'}</button>
        </div>
        <div class="ex-note">${ex.note}</div>
        <div class="w-row">
          ${seatHTML}
          <span class="w-lbl">Weight</span>
          <div id="wc-${di}-${ei}">${weightHTML}</div>
        </div>
        <div class="prog-row">
          <div class="prog-track"><div class="prog-fill" id="pf-${day.id}-${ei}" style="width:${pct}%;background:${c}"></div></div>
          <span class="prog-lbl" id="pl-${day.id}-${ei}">${done}/${ex.sets.length}</span>
        </div>
      </div>
      <div class="form-panel${fOpen?' open':''}" id="fp-${day.id}-${ei}" style="--c:${c}">${formHTML}</div>
      <div class="sets">${setsHTML}</div>
    </div>`;
  }).join('');
}

// ─────────────────────────────────────────────
//  INIT
// ─────────────────────────────────────────────
renderDayGrid();
renderExercises();
</script>
